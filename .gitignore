# ==========================================
# PYTHON - .gitignore
# ==========================================

# Cache e arquivos compilados
__pycachertualenv/
pyvenv.cfg

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# VS Code
.vscode/
*.code-workspace

# PyCharm e outras IDEs
.idea/
*.iml

# Jupyter Notebook / Google Colab
.ipynb_checkpoints/
*.nbconvert.ipynb

# Testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Logs e arquivos temporários
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~
.cache/

# Build e distribuição
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Dados locais e bancos SQLite
*.db
*.sqlite
*.sqlite3

# Datasets locais (ajustar conforme projeto)
datasets/
data/raw/
data/processed/

# Modelos de IA e Machine Learning
models/
checkpoints/
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.onnx
*.safetensors

# Bancos vetoriais locais
chroma_db/
chroma_data/
chroma_storage/
qdrant_storage/
faiss_index/

# Resultados gerados
outputs/
results/
artifacts/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
